.claude/settings.local.json
.DS_Store
node_modules/
server/data/
# runtime-staat + sleutels van de Rust-motor (state.json, secret.key, vault.key):
# nooit committen -- privaat sleutelmateriaal en de hele geldstand
motor-data/
# de sleutel en brokken van de GEHEUGEN-motor: nooit committen, ook niet als
# RTG_DATA_DIR ergens anders wijst dan server/data
**/geheugen.key
**/geheugen/
# native TLS: self-signed certs, ACME-accountsleutel en opgehaalde certificaten:
# privaat sleutelmateriaal, nooit committen (ook niet bij een andere RTG_DATA_DIR)
**/tls/self.key
**/tls/self.crt
**/tls/acme-account.key
**/tls/live/
**/tls/ca/
.env
.env.*
.vercel
public/dist/

# het routejournaal van de laatste suite-run: invoer voor scripts/dekking.js,
# geen bron. Wordt bij elke `npm test` opnieuw geschreven.
.routejournaal
# idem voor de schermen: invoer voor scripts/schermen.js, geen bronbestand
.schermjournaal

# de ijkbestanden van test/meterijk.test.js. Die toets controleert of de
# normmeters echt uitslaan door er even een bestand bij te zetten (een extra
# toets, een extra route, een extra scherm) en het daarna weer weg te halen.
# Ze bestaan dus een seconde, midden IN de repo, en wie in dat moment naar
# `git status` keek zag ze als nieuw werk. Committen zou een wegwerpfixture
# vastleggen die de volgende run weer opruimt.
zz-ijk-tijdelijk.*
**/zz-ijk-tijdelijk.*

# dekkingsdata van de laatste run: invoer voor scripts/samenhang.js, geen bron.
# Twintig minuten om te maken, dus niet in de repo -- de census meldt netjes
# NIET GEMETEN als hij er niet is.
DEKKING-LCOV.info

# De wegwerpbestanden van de ijk-toets (test/meterijk.test.js). Die toets zet
# met opzet bekend-foute code in de boom om te bewijzen dat de meters er echt
# op uitslaan, en ruimt ze daarna zelf op.
#
# Ze horen om TWEE redenen genegeerd te worden, en beide takken hebben er hier
# onafhankelijk een gevonden -- vandaar dat beide regels blijven staan.
#   1. `git add -A` tijdens een draaiende toets commit ze mee. Dat scheelde een
#      haar. Ze zijn nooit bron.
#   2. Ze mogen ook niet als "los bestand" OPVALLEN terwijl de toets draait:
#      dan gooit iemand (of een agent die netjes wil opruimen) ze weg voordat
#      de meter geteld heeft, en zakt de ijking op een fout die er niet is.
#      Dat is hier gebeurd.
# Achterblijvers worden niet door git bewaakt maar door de toets zelf.
zz-ijk-tijdelijk*
server/kern/zz-ijk-tijdelijk*.js
server/routes/zz-ijk-tijdelijk*.js
