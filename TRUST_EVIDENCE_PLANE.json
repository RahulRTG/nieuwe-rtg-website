{
  "format": "rtg-trust-evidence-plane-v3",
  "mode": "shadow",
  "promise": "evidence coordinates domains; domains retain meaning and ownership",
  "universalProtocol": [
    "INTENT",
    "AUTHORITY",
    "COMMITMENT",
    "EXECUTION",
    "CONFIRMATION",
    "SETTLEMENT",
    "OUTCOME"
  ],
  "truthClasses": [
    "TECHNICAL",
    "DOMAIN",
    "EXTERNAL",
    "OPERATIONAL"
  ],
  "finality": [
    "UNKNOWN",
    "UNVERIFIED",
    "SOURCE_ATTESTED",
    "CROSS_VERIFIED",
    "RECONCILED",
    "DISPUTED",
    "REVERSED",
    "CANCELLED"
  ],
  "correlationChain": [
    "availability",
    "experience",
    "booking",
    "payment",
    "fulfillment",
    "outcome"
  ],
