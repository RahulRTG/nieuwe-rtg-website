# Niet-geheime Docker/hostinstellingen. Kopieer naar deploy/live.env.
# deploy/live.env staat in .gitignore; echte geheimen staan apart in
# .env.productie en .rtg-secrets/.

# Publieke poorten voor native HTTPS in RTG zelf.
RTG_PUBLISH_HOST=0.0.0.0
RTG_PUBLISH_PORT=443
RTG_CONTAINER_PORT=443

# Een ABSOLUTE map op een tweede schijf/mount of afzonderlijk back-upvolume.
# De live-compose weigert te starten als dit veld ontbreekt.
RTG_BACKUP_HOST_DIR=/mnt/rtg-backups
RTG_BACKUP_RETENTION_DAYS=30
RTG_BACKUP_INTERVAL=86400
# Hostpad naar de afzonderlijke geldsnapshot-sleutelring. De sleutelgenerator
# maakt dit bestand alleen bij de expliciete installatie; containers maken of
# roteren hem nooit tijdens start/restart.
RTG_MOTOR_STATE_KEY_SECRET_FILE=.rtg-secrets/motor_state_key
# Publiek certificaat blijft op de server; de bijbehorende PRIVESLEUTEL alleen
# offline bewaren en uitsluitend tijdens een bewust herstel aansluiten.
RTG_BACKUP_PUBLIC_CERT_FILE=.rtg-secrets/backup_public_cert.pem
# Een tweede, echt off-site doel met WORM/Object Lock/retentie. De bevestiging
# maakt expliciet dat die onveranderlijkheid door de opslagdienst wordt afgedwongen.
RTG_BACKUP_OFFSITE_HOST_DIR=/mnt/rtg-offsite-worm
RTG_BACKUP_OFFSITE_IMMUTABLE=1

# Unieke CI-kandidaten uit het release-image workflowartefact. Tags mogen nooit
# worden hergebruikt; live:golive verifieert hun getekende registrydigest en
# SBOM voordat een container start. `live:deploy` gebruikt daarna digestrefs.
RTG_CANDIDATE_IMAGE=ghcr.io/organisatie/repository:candidate-COMMITSHA-RUNID
RTG_CANDIDATE_BACKUP_IMAGE=ghcr.io/organisatie/repository:candidate-backup-COMMITSHA-RUNID
# Fallbacklabel voor niet-releasebeheer; de productiewissel bouwt dit niet.
RTG_IMAGE=rtg-app:live
# Alleen op een lege host, en alleen bewust: zonder deze exacte tekst weigert
# live:deploy een eerste wissel waarvoor nog geen rollbackimage bestaat.
RTG_EERSTE_UITROL=NIET-BEVESTIGD

# De PIN-antifraudegrenzen moeten in live-productie over alle instances delen.
RTG_PIN_ENTERPRISE=1

# De ingebouwde STUN-server; voor bellen door strenge firewalls is daarnaast
# een TURN-server nodig (zie LIVEGANG.md).
STUN_PORT=3478
