    {
      "id": "living-world-domain",
      "layer": "OPERATIONAL",
      "test": "test/living-world.test.js",
      "scope": "Menselijke lus over drie leden, mediareferentie, fork, wijziging, intrekking, verval, handmatige overname en vrijwillige impact; geen externe boekingen."
    },
    {
      "id": "living-world-http",
      "layer": "OPERATIONAL",
      "test": "test/living-world-http.test.js",
      "scope": "Echte HTTP-sessies, Broker, gedeelde bron, privéplan, organisator, deelname, review, verbetering en volgende persoon met betalingen, AI en push uit."
    },
    {
      "id": "living-world-sources",
      "layer": "RESILIENCE",
      "test": "test/living-world-sources.test.js",
      "scope": "Bronverbindingen zonder kopie van boekingen, privérechten, correcties en ingetrokken deelname in Connect."
    },
    {
      "id": "living-world-sqlite",
      "layer": "RESILIENCE",
      "test": "test/living-world-sqlite.test.js",
      "scope": "Twee echte processen: ontvangstbewijs na herstart, gelijktijdigheid, revisieconflict en rollback vóór commit."
    },
    {
      "id": "living-world-browser",
      "layer": "EXPERIENCE",
      "test": "test/living-world.e2e.js",
      "scope": "Chromium op 390 en 1440 pixels: maken, Edge-actie, aanvraag, besluit, deelname, bijdrage, review, blueprintverbetering en Connect. Geen fysiek toestel of gebruiksonderzoek."
