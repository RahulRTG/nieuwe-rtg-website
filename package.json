{
  "name": "rtg-website",
  "version": "1.0.0",
  "private": true,
  "description": "Rahul Travel Group, website, ledenportaal en backend",
  "scripts": {
    "start": "node scripts/start.js",
    "telefoon": "RTG_LOKAAL_TLS=1 node server/trio.js",
    "single": "node --experimental-sqlite server/server.js",
    "gateway": "node server/poort.js",
    "vloot": "node server/vloot.js",
    "sleutels": "node scripts/sleutels.js",
    "selfhost:init": "node scripts/sleutels.js --docker --prive-beta --schrijf",
    "selfhost:check": "node scripts/docker/controle.js",
    "live:init": "node scripts/sleutels.js --docker --schrijf --zonder-ai --zonder-betalen --native-tls --stil",
    "live:check": "sh scripts/docker/live.sh check",
    "live:deploy": "sh scripts/docker/live.sh deploy",
    "live:owner": "sh scripts/docker/live.sh owner",
    "live:golive": "sh scripts/docker/live.sh golive",
    "live:status": "sh scripts/docker/live.sh status",
    "live:probe": "sh scripts/docker/live.sh probe",
    "live:backup": "sh scripts/docker/live.sh backup",
    "live:rollback": "sh scripts/docker/live.sh rollback",
    "live:restore": "sh scripts/docker/live.sh restore",
    "ai:lokaal:check": "node scripts/lokale-ai-check.js",
    "kluisbeheer": "node --experimental-sqlite scripts/kluisbeheer.js",
    "outbox": "node scripts/outbox.js",
    "eigenpost": "node scripts/eigenpost.js",
    "golive": "node scripts/golive.js",
    "poortwacht": "node scripts/poortwacht.js",
    "rand": "node scripts/rand.js",
    "beproeving": "node --experimental-sqlite scripts/beproeving.js",
    "tandeloos": "node scripts/tandeloos.js",
    "onbetreden": "node scripts/onbetreden.js",
    "ladder": "node scripts/ladder.js",
    "verhalen": "node scripts/verhalen.js",
    "papierwerk": "node scripts/papierwerk.js",
    "beproeving:streng": "STRENG=1 node --experimental-sqlite scripts/beproeving.js",
    "beproeving:mega": "node --max-old-space-size=8192 scripts/beproeving.js",
    "slotsuite": "node --experimental-sqlite scripts/slotsuite.js",
    "slotsuite:snel": "node --experimental-sqlite scripts/slotsuite.js --snel",
    "keuring": "node --experimental-sqlite scripts/keuring.js",
    "nood": "node server/nood.js",
    "check": "node scripts/check.js",
    "ast-scan": "node scripts/ast-scan.js",
    "a11y": "node scripts/a11y.js",
    "build": "node scripts/build.js",
    "test": "rm -f .routejournaal && RTG_ROUTELOG=.routejournaal node --experimental-sqlite --test --test-concurrency=4 test/*.test.js",
    "test:coverage": "node --experimental-sqlite --experimental-test-coverage --test test/*.test.js",
    "test:gate": "node --experimental-sqlite --experimental-test-coverage --test-coverage-lines=58 --test-coverage-branches=74 --test-coverage-functions=47 --test test/*.test.js",
    "audit": "npm audit --audit-level=high",
    "secrets": "node scripts/geheimen.js",
    "schermen": "node scripts/schermen.js",
    "e2e": "rm -f .schermjournaal && RTG_ROUTELOG=.schermjournaal node --experimental-sqlite --test --test-concurrency=1 --test-timeout=600000 test/*.e2e.js",
    "test:pg": "node scripts/pgtoetsen.js",
    "icons": "node scripts/icons.js",
    "norm": "node --experimental-sqlite scripts/norm.js",
    "norm:vast": "node --experimental-sqlite scripts/norm.js --vastleggen",
    "dekking": "node --experimental-sqlite scripts/dekking.js",
    "dekking:vast": "node --experimental-sqlite scripts/dekking.js --vastleggen",
    "samenhang": "node --experimental-sqlite scripts/samenhang.js",
    "samenhang:vast": "node --experimental-sqlite scripts/samenhang.js --vastleggen",
    "kaart": "node scripts/kaart.js",
    "bewijs": "node scripts/bewijs.js",
    "belofte": "node scripts/belofte.js",
    "slo": "node scripts/slo.js --schrijf",
    "sonde": "node scripts/sonde.js",
    "chaos": "node scripts/chaos.js",
    "grenzen": "node scripts/grenzen.js",
    "leugens": "node --experimental-sqlite scripts/leugendetector.js",
    "mutatie": "node --experimental-sqlite scripts/mutatie.js",
    "grenslijst": "node scripts/grenslijst.js",
    "wetten": "node scripts/wetten.js",
    "sabotage": "node --experimental-sqlite scripts/sabotage.js",
    "zekerheid": "node scripts/zekerheid.js",
    "bewijsmatrix": "node --experimental-sqlite scripts/bewijsmatrix.js",
    "bewijsmatrix:vast": "node --experimental-sqlite scripts/bewijsmatrix.js --vastleggen",
    "klok": "node scripts/klok.js",
    "klok:vast": "node scripts/klok.js --vastleggen",
    "controls": "node scripts/controls.js",
    "controls:vast": "node scripts/controls.js --vastleggen",
    "rolproef": "node --experimental-sqlite scripts/rolproef-route.js",
    "invoerproef": "node --experimental-sqlite scripts/invoerproef-route.js",
    "idemproef": "node --experimental-sqlite scripts/idemproef-route.js",
    "staatproef": "node --experimental-sqlite scripts/staatproef-route.js",
    "kosten": "node --experimental-sqlite scripts/duurzaamheidskosten.js",
    "verraadcatalogus": "node -e \"const v=require('./server/lib/verraad');for(const x of v.CATALOGUS)console.log((x.waar?'[ingebouwd] ':'[voornemen] ')+x.naam.padEnd(18)+x.wat)\"",
    "verraad": "node --experimental-sqlite scripts/verraadronde.js",
    "ketenronde": "node --experimental-sqlite scripts/ketenronde.js",
    "motor:build": "cargo build --release --manifest-path motor/Cargo.toml --locked",
    "motor:test": "cargo test --release --manifest-path motor/Cargo.toml --locked",
    "motor:start": "motor/target/release/rtg-motor",
    "start:rust": "node scripts/start-met-motor.js"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
