{
  "name": "rtg-website",
  "version": "1.0.0",
  "private": true,
  "description": "Rahul Travel Group, website, ledenportaal en backend",
  "scripts": {
    "start": "node server/trio.js",
    "telefoon": "RTG_LOKAAL_TLS=1 node server/trio.js",
    "single": "node --experimental-sqlite server/server.js",
    "gateway": "node server/poort.js",
    "vloot": "node server/vloot.js",
    "sleutels": "node scripts/sleutels.js",
    "kluisbeheer": "node --experimental-sqlite scripts/kluisbeheer.js",
    "outbox": "node scripts/outbox.js",
    "golive": "node scripts/golive.js",
    "poortwacht": "node scripts/poortwacht.js",
    "rand": "node scripts/rand.js",
    "beproeving": "node --experimental-sqlite scripts/beproeving.js",
    "tandeloos": "node scripts/tandeloos.js",
    "onbetreden": "node scripts/onbetreden.js",
    "ladder": "node scripts/ladder.js",
    "verhalen": "node scripts/verhalen.js",
    "papierwerk": "node scripts/papierwerk.js",
    "beproeving:streng": "STRENG=1 node --experimental-sqlite scripts/beproeving.js",
    "beproeving:mega": "node --max-old-space-size=8192 scripts/beproeving.js",
    "slotsuite": "node --experimental-sqlite scripts/slotsuite.js",
    "slotsuite:snel": "node --experimental-sqlite scripts/slotsuite.js --snel",
    "keuring": "node --experimental-sqlite scripts/keuring.js",
    "nood": "node server/nood.js",
    "check": "node scripts/check.js",
    "ast-scan": "node scripts/ast-scan.js",
    "a11y": "node scripts/a11y.js",
    "build": "node scripts/build.js",
    "test": "rm -f .routejournaal && RTG_ROUTELOG=.routejournaal node --experimental-sqlite --test test/*.test.js",
    "test:coverage": "node --experimental-sqlite --experimental-test-coverage --test test/*.test.js",
    "test:gate": "node --experimental-sqlite --experimental-test-coverage --test-coverage-lines=58 --test-coverage-branches=74 --test-coverage-functions=47 --test test/*.test.js",
    "audit": "npm audit --audit-level=high",
    "secrets": "node scripts/geheimen.js",
    "schermen": "node scripts/schermen.js",
    "e2e": "rm -f .schermjournaal && RTG_ROUTELOG=.schermjournaal node --experimental-sqlite --test test/*.e2e.js",
    "test:pg": "node scripts/pgtoetsen.js",
    "icons": "node scripts/icons.js",
    "norm": "node --experimental-sqlite scripts/norm.js",
    "norm:vast": "node --experimental-sqlite scripts/norm.js --vastleggen",
    "dekking": "node --experimental-sqlite scripts/dekking.js",
    "dekking:vast": "node --experimental-sqlite scripts/dekking.js --vastleggen",
    "samenhang": "node --experimental-sqlite scripts/samenhang.js",
    "samenhang:vast": "node --experimental-sqlite scripts/samenhang.js --vastleggen"
  },
  "dependencies": {
    "zz-ijk-tijdelijk": "^1.0.0"
  }
}
