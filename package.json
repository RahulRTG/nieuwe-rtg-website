{
  "name": "rtg-website",
  "version": "1.0.0",
  "private": true,
  "description": "Rahul Travel Group, website, ledenportaal en backend",
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "telefoon": "RTG_LOKAAL_TLS=1 node server/trio.js",
    "single": "node server/server.js",
    "gateway": "node server/poort.js",
    "vloot": "node server/vloot.js",
    "sleutels": "node scripts/sleutels.js",
    "selfhost:init": "node scripts/sleutels.js --docker --prive-beta --schrijf",
    "selfhost:check": "node scripts/docker/controle.js",
    "live:init": "node scripts/sleutels.js --docker --schrijf --zonder-ai --zonder-betalen --zonder-sms --native-tls --stil",
    "live:check": "sh scripts/docker/live.sh check",
    "live:deploy": "sh scripts/docker/live.sh deploy",
    "live:owner": "sh scripts/docker/live.sh owner",
    "live:golive": "sh scripts/docker/live.sh golive",
    "live:status": "sh scripts/docker/live.sh status",
    "live:probe": "sh scripts/docker/live.sh probe",
    "live:backup": "sh scripts/docker/live.sh backup",
    "backup:sleutel": "sh scripts/docker/backup-sleutel.sh",
    "live:rollback": "sh scripts/docker/live.sh rollback",
    "live:restore": "sh scripts/docker/live.sh restore",
    "ai:lokaal:check": "node scripts/lokale-ai-check.js",
    "kluisbeheer": "node scripts/kluisbeheer.js",
    "outbox": "node scripts/outbox.js",
    "eigenpost": "node scripts/eigenpost.js",
    "golive": "node scripts/golive.js",
    "poortwacht": "node scripts/poortwacht.js",
    "rand": "node scripts/rand.js",
    "beproeving": "node scripts/beproeving.js",
    "tandeloos": "node scripts/tandeloos.js",
    "onbetreden": "node scripts/onbetreden.js",
    "ladder": "node scripts/ladder.js",
    "verhalen": "node scripts/verhalen.js",
    "papierwerk": "node scripts/papierwerk.js",
    "beproeving:streng": "STRENG=1 node scripts/beproeving.js",
    "beproeving:mega": "node --max-old-space-size=8192 scripts/beproeving.js",
    "slotsuite": "node scripts/slotsuite.js",
    "slotsuite:snel": "node scripts/slotsuite.js --snel",
    "keuring": "node scripts/keuring.js",
    "nood": "node server/nood.js",
    "check": "node scripts/check.js",
    "ast-scan": "node scripts/ast-scan.js",
    "ci-keten": "node scripts/ci-keten.js",
    "a11y": "node scripts/a11y.js",
    "build": "node scripts/build.js",
    "release:build": "npm run build && npm run motor:build && npm run check && npm run release:bewijs",
    "release:bewijs": "node scripts/release-bewijs.js",
    "release:controle": "node scripts/release-bewijs.js --controle",
    "release:gate": "node scripts/release-gate.js",
    "release:gate:productie": "node scripts/release-gate.js --productie",
    "staging:repetitie": "node scripts/staging-repetitie.js",
    "afbouw:snel": "npm run release:gate && npm run staging:repetitie",
    "afbouw:software": "npm test && npm run release:gate && npm run staging:repetitie",
    "afbouw:alles": "npm run afbouw:software && npm run golive",
    "deploy:productie": "node scripts/uitrol.js --uitrollen",
    "deploy:terug": "node scripts/uitrol.js --terug",
    "pretest": "npm run motor:build",
    "test": "node scripts/test-runner.js",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.js",
    "pretest:gate": "npm run motor:build",
    "test:gate": "node --experimental-test-coverage --test-coverage-lines=58 --test-coverage-branches=74 --test-coverage-functions=47 --test test/*.test.js",
    "audit": "npm audit --audit-level=high",
    "secrets": "node scripts/geheimen.js",
    "schermen": "node scripts/schermen.js",
    "e2e": "rm -f .schermjournaal && RTG_ROUTELOG=.schermjournaal node --test --test-concurrency=1 --test-timeout=600000 test/*.e2e.js",
    "test:pg": "node scripts/pgtoetsen.js",
    "icons": "node scripts/icons.js",
    "norm": "node scripts/norm.js",
    "norm:vast": "node scripts/norm.js --vastleggen",
    "dekking": "node scripts/dekking.js",
    "dekking:vast": "node scripts/dekking.js --vastleggen",
    "samenhang": "node scripts/samenhang.js",
    "samenhang:vast": "node scripts/samenhang.js --vastleggen",
    "kaart": "node scripts/kaart.js",
    "bewijs": "node scripts/bewijs.js",
    "belofte": "node scripts/belofte.js",
    "slo": "node scripts/slo.js --schrijf",
    "sonde": "node scripts/sonde.js",
    "grondwacht": "node scripts/grondwacht.js",
    "wetwacht": "node scripts/wetwacht.js",
    "wetwacht:vast": "node scripts/wetwacht.js --vastleggen",
    "triage": "node scripts/triage.js",
    "chaos": "node scripts/chaos.js",
    "grenzen": "node scripts/grenzen.js",
    "leugens": "node scripts/leugendetector.js",
    "mutatie": "node scripts/mutatie.js",
    "grenslijst": "node scripts/grenslijst.js",
    "wetten": "node scripts/wetten.js",
    "sabotage": "node scripts/sabotage.js",
    "zekerheid": "node scripts/zekerheid.js",
    "bewijsmatrix": "node scripts/bewijsmatrix.js",
    "bewijsmatrix:vast": "node scripts/bewijsmatrix.js --vastleggen",
    "klok": "node scripts/klok.js",
    "klok:vast": "node scripts/klok.js --vastleggen",
    "controls": "node scripts/controls.js",
    "controls:vast": "node scripts/controls.js --vastleggen",
    "rolproef": "node scripts/rolproef-route.js",
    "invoerproef": "node scripts/invoerproef-route.js",
    "idemproef": "node scripts/idemproef-route.js",
    "staatproef": "node scripts/staatproef-route.js",
    "kosten": "node scripts/duurzaamheidskosten.js",
    "verraadcatalogus": "node -e \"const v=require('./server/lib/verraad');for(const x of v.CATALOGUS)console.log((x.waar?'[ingebouwd] ':'[voornemen] ')+x.naam.padEnd(18)+x.wat)\"",
    "verraad": "node scripts/verraadronde.js",
    "ketenronde": "node scripts/ketenronde.js",
    "motor:build": "cargo build --release --manifest-path motor/Cargo.toml --locked",
    "motor:test": "cargo test --release --manifest-path motor/Cargo.toml --locked",
    "motor:migraties": "node scripts/rust-migraties.js",
    "motor:migraties:controle": "node scripts/rust-migraties.js --controle",
    "motor:start": "motor/target/release/rtg-motor",
    "motor:cutover": "node scripts/motor-cutover.js",
    "magnaat:productieproef": "node --test test/magnaat-trainingslobby.test.js test/magnaat-teamkamer-productie.test.js test/collectie-transactie-sqlite.test.js test/magnaat-rust-integratie.test.js test/productie-motor.test.js",
    "sentinel:init": "node scripts/sentinel-beheer.js init",
    "sentinel:start": "node scripts/sentinel-beheer.js start",
    "sentinel:status": "node scripts/sentinel-beheer.js status",
    "sentinel:audit": "node scripts/sentinel-beheer.js audit",
    "sentinel:scan": "node scripts/sentinel-beheer.js scan",
    "sentinel:watch": "node scripts/sentinel-beheer.js watch",
    "sentinel:restrict": "node scripts/sentinel-beheer.js restrict",
    "sentinel:isolate": "node scripts/sentinel-beheer.js isolate",
    "sentinel:restore": "node scripts/sentinel-beheer.js restore",
    "sentinel:audit:verify": "node scripts/sentinel-beheer.js verify-audit",
    "sentinel:audit:recover": "node scripts/sentinel-beheer.js recover-audit",
    "start:rust": "node scripts/start-met-motor.js",
    "prestaties": "node scripts/prestaties.js"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
