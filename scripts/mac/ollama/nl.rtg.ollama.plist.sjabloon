<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Gebruikersservice: geen root, geen publieke luisterpoort en geen geheimen. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.rtg.ollama</string>
  <key>ProgramArguments</key>
  <array>
    <string>@@OLLAMA@@</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>@@HOME@@</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>OLLAMA_HOST</key>
    <string>127.0.0.1:11434</string>
    <key>OLLAMA_NO_CLOUD</key>
    <string>1</string>
    <key>OLLAMA_CONTEXT_LENGTH</key>
    <string>4096</string>
    <key>OLLAMA_MAX_LOADED_MODELS</key>
    <string>1</string>
    <key>OLLAMA_NUM_PARALLEL</key>
    <string>1</string>
    <key>OLLAMA_MAX_QUEUE</key>
    <string>8</string>
    <key>OLLAMA_KEEP_ALIVE</key>
    <string>3m</string>
    <key>OLLAMA_FLASH_ATTENTION</key>
    <string>1</string>
    <key>OLLAMA_KV_CACHE_TYPE</key>
    <string>q8_0</string>
    <key>OLLAMA_LOAD_TIMEOUT</key>
    <string>5m</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <!-- Background knijpt Metal/GPU-detectie af op sommige Macs. Interactive
       houdt antwoorden vlot; KEEP_ALIVE=3m laat het model daarna weer los. -->
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>@@HOME@@/Library/Logs/rtg-ollama.log</string>
  <key>StandardErrorPath</key>
  <string>@@HOME@@/Library/Logs/rtg-ollama.log</string>
</dict>
</plist>
